# Every value here is public: the Supabase publishable key is the same one the
# website ships to every browser. Real secrets live on the server and in EAS.
#
# Copy to .env only if you need to point the app somewhere other than
# production; the defaults in src/lib/config.ts already work.

# EXPO_PUBLIC_SUPABASE_URL=https://ervsfjyuhtnepigfgskh.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The app API and the render surface in the web repo (master plan §9, §14).
# EXPO_PUBLIC_API_URL=https://pitchpage.co/api/app/v1
# EXPO_PUBLIC_RENDER_URL=https://pitchpage.co/app-render
